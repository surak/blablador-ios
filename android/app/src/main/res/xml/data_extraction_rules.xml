<?xml version="1.0" encoding="utf-8"?>
<!-- The API key and the encrypted chats, memories and files can't be restored on another device (its Keystore key stays behind), so leave them out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="conversations.json" />
        <exclude domain="file" path="memories.json" />
        <exclude domain="file" path="decisions.json" />
        <exclude domain="file" path="skills.json" />
        <exclude domain="file" path="images" />
        <exclude domain="file" path="audio" />
        <exclude domain="file" path="videos" />
        <exclude domain="file" path="voices" />
        <exclude domain="file" path="knowledge" />
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="conversations.json" />
        <exclude domain="file" path="memories.json" />
        <exclude domain="file" path="decisions.json" />
        <exclude domain="file" path="skills.json" />
        <exclude domain="file" path="images" />
        <exclude domain="file" path="audio" />
        <exclude domain="file" path="videos" />
        <exclude domain="file" path="voices" />
        <exclude domain="file" path="knowledge" />
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
