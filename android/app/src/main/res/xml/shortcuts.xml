<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="ask"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_ask"
        android:shortcutLongLabel="@string/shortcut_ask">
        <intent
            android:action="de.fz_juelich.blablador.NEW_CHAT"
            android:targetPackage="de.fz_juelich.blablador"
            android:targetClass="de.fz_juelich.blablador.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="memory"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_memory"
        android:shortcutLongLabel="@string/shortcut_memory">
        <intent
            android:action="de.fz_juelich.blablador.ADD_MEMORY"
            android:targetPackage="de.fz_juelich.blablador"
            android:targetClass="de.fz_juelich.blablador.MainActivity" />
    </shortcut>
</shortcuts>
